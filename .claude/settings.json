{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(python -m py_compile:*)",
      "Bash(python -c:*)",
      "Bash(python --version)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(uv:*)",
      "Bash(gh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git config core.hooksPath)",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git tag:*)",
      "Bash(git stash:*)",
      "Bash(git reset:*)",
      "Bash(powershell:*)",
      "Bash(powershell.exe:*)",
      "PowerShell(powershell:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sed -n:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Read(**/chrome_profile/**)",
      "Read(**/daemon_token)",
      "Read(**/storage_state.json)",
      "Read(**/fingerprint.json)",
      "Read(**/recordings/**)"
    ]
  }
}
