# =====================================================================
#  Концы строк задаются здесь, а не настройкой core.autocrlf у каждого.
#
#  Почему явно: core.autocrlf живёт в конфиге машины и у разных
#  участников разный. При несовпадении git показывает изменёнными файлы,
#  в которых нет ни одной содержательной правки, а diff раздувается до
#  полного файла — ревью становится невозможным, а критерий «git status
#  чист» не закрывается ни на одном этапе.
# =====================================================================
* text=auto

# PowerShell 5.1 читает скрипт как ANSI, если нет BOM, и ломается на
# кириллице — а её здесь и в коде, и в именах команд. BOM атрибутом
# text не затрагивается: он правит только концы строк. CRLF потому,
# что это родной формат для Windows PowerShell.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

*.py   text eol=lf
*.json text eol=lf
# Файл с расширением .example под *.json не подпадает. Сейчас таких файлов
# в репозитории нет — образец конфигурации MCP-клиента удалён решением 14
# вместе с раскладкой, которую он описывал. Правило оставлено: следующий
# образец обязан приезжать с теми же концами строк, что и настоящий файл,
# иначе сравнивать их глазами становится нельзя.
*.example text eol=lf

# LICENSE и NOTICE расширения не имеют и под правила выше не подпадают.
# Явный LF: их читают на всех системах, а Apache-2.0 требует доносить
# NOTICE при распространении — пусть едет в одном виде, а не в зависимости
# от того, на чём его выгрузили.
LICENSE text eol=lf
NOTICE  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.sh   text eol=lf

# Хук исполняется через sh: CRLF в шебанге даёт «bad interpreter».
hooks/* text eol=lf
