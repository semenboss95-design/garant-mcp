#  описывает раскладку окон и плагины конкретной машины и клонировавшему
#  бесполезен.
.obsidian/
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# =====================================================================
#  ВНУТРЕННЯЯ КУХНЯ — наружу не идёт
#  Рабочее состояние, планы и промты нужны только тому, кто ведёт работу.
#  Клонировавшему они бесполезны и создают шум на первом экране репозитория.
#  Следствие: ни один публичный файл не имеет права на них ссылаться —
#  у постороннего этих файлов нет, и ссылка ведёт в пустоту.
# =====================================================================
#  Каталог целиком, а не поимённо: раньше здесь стояла одна строка
#  memory/STATE.md, и CLAUDE.md при этом утверждал, что приватен весь
#  memory/. Расхождение вскрылось, когда в него лёг второй файл — аудит
#  архитектуры: он не подпадал ни под один образец и ушёл бы в клон
#  первым же `git add`.
memory/
#  Образцы по семейству имени, а не по одной его форме. Прежде здесь стояли
#  PLAN_[0-9][0-9]_*, PROMPT_CLAUDE_CODE_* и REVIEW_[0-9][0-9]_* — файл
#  с другим именем (плана без номера, промта аудита) под них не подпадал
#  и уходил бы в клон первым же `git add`. Хук от этого не спасает: он
#  смотрит на содержимое, а не на имя.
PLAN_*.md
PROMPT_*.md
REVIEW_*.md
RELEASE_NOTES_FOR_AGENT.md

#  Память агентов: файлы пишет харнесс, они принадлежат этой машине
#  и валят проверку «в дереве нет неожиданного неотслеживаемого».
.claude/agent-memory/

# =====================================================================
#  Локальные разрешения этой машины
#
#  Claude Code дописывает сюда одобренные команды, и они приходят с полным
#  путём рабочей машины. У другого клона путь другой, а у постороннего этот
#  файл раскрыл бы раскладку чужого диска.
#
#  Закрывать здесь, а не полагаться на глобальный ignore пользователя:
#  глобальный лежит вне репозитория и с клоном не приезжает — ровно так же,
#  как не приезжает core.hooksPath. Защита, которой нет в репозитории,
#  у постороннего выключена, и он об этом не узнает.
#
#  settings.json (без .local) — часть конфигурации команды и коммитится.
# =====================================================================
.claude/settings.local.json
