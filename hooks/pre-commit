#!/bin/sh
# =====================================================================
#  pre-commit — механическая защита публичного репозитория garant-mcp
#
#  Почему механизм, а не правило в документации: утечка daemon_token или
#  storage_state.json в публичный репозиторий необратима — коммит остаётся
#  в истории и в форках. .gitignore спасает от невнимательности, но не от
#  `git add -f`, а имя файла меняется одной командой. Поэтому проверяется
#  СОДЕРЖИМОЕ того, что реально уходит в индекс.
#
#  Раньше уровней было два: ОТКАЗ на необратимое и ПРЕДУПРЕЖДЕНИЕ на следы
#  прежней плоской раскладки. Второй уровень был вынужденным: этих литералов
#  в коде было 19 в 9 файлах, и строгий хук не пропустил бы первый же коммит,
#  а хук, отвергающий всё подряд, отключают в первый же день.
#
#  С приёмкой этапа 01 (04.09.2026) литералов не осталось, и предупреждение
#  перестало нести информацию. Теперь это ОТКАЗ: с этого момента появление
#  такого литерала — регрессия, а не наследство. Решение 6 в docs/DECISIONS.md.
#
#  ЧЕГО ЗДЕСЬ БОЛЬШЕ НЕТ (06.09.2026). Детектор сам был единственным файлом
#  дерева, который называл имя пользователя рабочей машины, имя прежнего
#  хранилища и каталог прежней раскладки: он нёс ровно то, что запрещает,
#  и пропускал сам себя — отчего «история чиста» было утверждением о том,
#  куда детектор не смотрит. Теперь:
#    * имя пользователя спрашивается у машины (см. USERPAT ниже);
#    * литералы конкретной машины вынесены в НЕОБЯЗАТЕЛЬНЫЙ файл
#      .git/garant-secrets, который не индексируется и не клонируется;
#    * исключение «пропустить сам хук» снято — хук проверяется наравне
#      со всеми. Условие, при котором это остаётся верным, одно:
#      ОБРАЗЦЫ ПИШУТСЯ ТАК, ЧТОБЫ НЕ СОВПАДАТЬ САМИ С СОБОЙ — через
#      класс символов ([Uu]sers, [A-Za-z]:), а не голым литералом.
#      Правя хук, держитесь этого; аварийный выход — SKIP_GARANT_HOOK=1.
#
#  ИСКЛЮЧЕНИЙ БОЛЬШЕ НЕТ НИ ОДНОГО (06.09.2026). Все три были выданы файлам
#  из scripts/, и вместе со scripts/ они умерли — решение 18. Механизма
#  поимённых исключений в хуке тоже не осталось: пустая функция exempt(),
#  вызываемая из трёх правил, выглядит работающим фильтром, но не фильтрует
#  ничего, и следующий добавит в неё строку, не заведя решения. Понадобится
#  исключение — оно заводится письменно (tech-lead) и возвращается вместе
#  со своим файлом; до тех пор каждое правило применяется ко всем.
#
#  Осознанный обход: SKIP_GARANT_HOOK=1 git commit …
#  Им пользуются сознательно и под свою ответственность.
#
#  Активация в клоне: git config core.hooksPath hooks
#  (core.hooksPath живёт в .git/config и НЕ клонируется — у постороннего
#   приедет файл хука, но не его включение; см. CLAUDE.md и hooks/README.md)
# =====================================================================

if [ "$SKIP_GARANT_HOOK" = "1" ]; then
    echo "pre-commit: пропущен по SKIP_GARANT_HOOK=1 — обход осознанный." >&2
    exit 0
fi

FAIL=0
TMP="$(mktemp)"
CAND="$(mktemp)"
LIST="$(mktemp)"
SEC="$(mktemp)"
trap 'rm -f "$TMP" "$CAND" "$LIST" "$SEC"' EXIT

# ------------------------------------------------- имя пользователя машины
#
# Литералом его здесь быть не может: публичный файл, называющий учётную
# запись автора, — это ровно та утечка, от которой хук и защищает.
# Спрашиваем у машины.
#
# Источников четыре, и это не перестраховка. На машине, где хук правили,
# `id -un` и $USERNAME дают имя учётной записи, а каталог профиля называется
# ИНАЧЕ — и в путях встречается именно имя каталога. Цепочка «первый
# непустой» проверяла бы не то имя и молчала бы об этом. Поэтому берём все
# источники и применяем каждое полученное имя.
USERPAT=''
for _cand in "$USER" "$USERNAME" "$(id -un 2>/dev/null)" "$(basename "${HOME:-/}" 2>/dev/null)"; do
    [ -n "$_cand" ] || continue
    # Имя короче трёх букв ловилось бы внутри обычных слов, и хук отвергал бы
    # законные коммиты — после чего его отключают. Пропуск лучше, но громкий.
    if [ "${#_cand}" -lt 3 ]; then
        echo "pre-commit: имя «$_cand» слишком короткое для образца — по нему проверка НЕ выполняется." >&2
        continue
    fi
    # Родовые имена (root, user, admin) машину не раскрывают, зато совпадают
    # в обычном тексте. Исключаем осознанно и вслух.
    case "$_cand" in
        root|Root|ROOT|user|User|USER|users|Users|admin|Admin|administrator|Administrator|home|Home)
            echo "pre-commit: имя «$_cand» родовое, машину не раскрывает — по нему проверка НЕ выполняется." >&2
            continue ;;
    esac
    # Имя с посторонними символами в regex не подставляем: экранировать всё
    # переносимо в /bin/sh нельзя, а неверно экранированный образец — это
    # проверка, которая молча ничего не ищет.
    case "$_cand" in
        *[!A-Za-z0-9._-]*)
            echo "pre-commit: имя «$_cand» содержит символы, непригодные для образца — по нему проверка НЕ выполняется." >&2
            continue ;;
    esac
    _esc="$(printf '%s' "$_cand" | sed 's/\./\\./g')"
    case "|$USERPAT|" in *"|$_esc|"*) continue ;; esac   # такое имя уже взято
    USERPAT="${USERPAT:+$USERPAT|}$_esc"
done
if [ -z "$USERPAT" ]; then
    # Молчать нельзя: пропущенная проверка, о которой никто не знает,
    # хуже отсутствующей.
    echo "pre-commit: имя пользователя машины получить не удалось (USER, USERNAME, id -un, HOME) — ПРАВИЛО ПРО ИМЯ ПОЛЬЗОВАТЕЛЯ НЕ ПРИМЕНЯЕТСЯ." >&2
else
    # Границы по не-буквенно-цифровому символу: иначе имя ловилось бы
    # внутри длинного слова и давало отказ на пустом месте.
    USERPAT='(^|[^A-Za-z0-9])('"$USERPAT"')([^A-Za-z0-9]|$)'
fi

# ------------------------------------------- образцы из .git/garant-secrets
#
# Здесь живут литералы КОНКРЕТНОЙ машины: имя прежнего хранилища, каталог
# прежней раскладки и прочее, чего у клонировавшего нет и быть не должно.
# Файл лежит в .git — он не индексируется, не клонируется и потому не
# превращает детектор в носителя того, что он ищет.
#
# Файла нет — эти правила не применяются. Это не дыра: у постороннего нет
# следов чужой машины, искать нечего. См. hooks/README.md.
_git_dir="$(git rev-parse --git-dir 2>/dev/null)"
if [ -n "$_git_dir" ] && [ -f "$_git_dir/garant-secrets" ]; then
    while IFS= read -r _pat || [ -n "$_pat" ]; do
        case "$_pat" in ''|'#'*) continue ;; esac
        # Непригодный образец отбрасываем громко: grep вернул бы 2, а
        # молчаливое «нет совпадений» неотличимо от выключенной проверки.
        printf '' | grep -qE "$_pat" 2>/dev/null
        if [ "$?" -gt 1 ]; then
            echo "pre-commit: образец из .git/garant-secrets непригоден для grep -E и ПРОПУЩЕН." >&2
            continue
        fi
        printf '%s\n' "$_pat" >> "$SEC"
    done < "$_git_dir/garant-secrets"
fi

# Файл считается кодом, если по расширению его содержимое пишет человек.
# Правило про длинные base64url-строки применяется только к НЕ-коду:
# в коде такая строка — это чаще всего разделитель или хеш в комментарии.
#
# Расширения .txt в этом списке нет, и это отдельное решение (07.09.2026).
# Оно там было, и правило про длинную base64url-строку к .txt не применялось —
# то есть подложенный в текстовый файл токен хук пропускал. А .txt — ровно то
# место, куда секрет и попадает: перенаправленный вывод команды, «сохранил
# на минуту», файл с pid рядом с корнем. Цена обратного решения сегодня нулевая:
# в индексе нет ни одного .txt, ложному срабатыванию не на чем случиться.
# Появится законный .txt с длинным идентификатором — это разбирается решением
# по своему файлу, а не молчаливым возвратом расширения в список.
is_code() {
    case "$1" in
        *.py|*.ps1|*.psm1|*.md|*.sh|*.yml|*.yaml|*.toml|*.cfg|*.ini) return 0 ;;
        .gitignore|*/.gitignore|*.example|*.example.json) return 0 ;;
        *) return 1 ;;
    esac
}

deny() {   # deny <файл> <строки> <правило>
    printf 'ОТКАЗ  %s\n' "$1" >&2
    printf '       %s\n' "$2" >&2
    printf '       правило: %s\n\n' "$3" >&2
    FAIL=1
}

# Функции exempt() здесь больше нет, и это не упущение. Все три исключения
# были выданы файлам из scripts/ (ворота и _common.ps1) и образцу
# .mcp.json.example; файлы удалены решением 18, вместе с ними удалены и
# исключения. Оставлять пустую функцию «на будущее» нельзя: пустой фильтр
# в защите выглядит как работающий механизм, а строку в него дописывают
# молча — то есть выключают правило без решения и без следа. Понадобится
# исключение — вернётся вместе с файлом, которому оно выдано, и с записью
# в docs/DECISIONS.md.

# Первые пять совпадений — достаточно, чтобы показать, где искать.
hits() { head -n 5; }

# Список через -z, а не через перевод строки: git по умолчанию заключает
# в кавычки и экранирует пути с не-ASCII (`каталог/Файл.txt` превращается
# в "каталог/Ð..."), и такой путь не открывается — файл молча проходил бы
# мимо проверки. Это не предусмотрительность на будущее: на 07.09.2026
# в дереве 34 файла с не-ASCII именем из 90 — больше трети, и почти все
# они в tests/. Без -z детектор не смотрел бы на эту треть вовсе.
# Чем кончается пренебрежение этим, известно из соседнего случая: тесты,
# перечислявшие файлы без -z, были зелёными и при этом не проверяли те же
# 36% дерева — подложенное нарушение в файле с русским именем не краснело
# (дефект 7, починен 06.09.2026). Флаг снимать нельзя ни при каких
# «упрощениях»: он не запас, а условие того, что проверка вообще идёт.
#
# NUL заменяется на перевод строки СРАЗУ, а цикл читает список построчно.
# Прямое чтение NUL-списка (`read -d ''`) есть только в bash, а хук
# исполняется тем sh, который найдётся у постороннего: на Debian
# и Ubuntu /bin/sh — это dash, и там ключа -d у read нет вовсе. Цена
# ошибки здесь максимальная: read падает на неизвестном ключе, условие
# цикла ложно с первой итерации, тело не исполняется НИ РАЗУ, FAIL
# остаётся нулём — и хук выходит с кодом 0, пропуская ВСЁ. На Windows,
# где sh — это bash, это не видно вовсе: дефект показал первый же
# прогон CI на ubuntu (08.09.2026), и это ровно то состояние «защита
# выглядит включённой и молчит», ради которого хук и написан.
# Поэтому весь файл пишется под POSIX sh, а не под тот sh, на котором
# его правят.
#
# Перевод строки ВНУТРИ имени файла эту схему не обманывает: имя
# разломится на две строки, ни одной из них в индексе не найдётся,
# `git show ":$f"` провалится — и сработает правило «не удалось прочитать
# содержимое», то есть ОТКАЗ, а не молчаливый пропуск.
git diff --cached --name-only --diff-filter=ACM -z | tr '\0' '\n' > "$LIST"
[ -s "$LIST" ] || exit 0

# ---------------------------------------------------------------- цикл
while IFS= read -r f; do

    # --- ОТКАЗ: файл подпадает под .gitignore (значит, попал через `git add -f`)
    # --no-index обязателен: без него git check-ignore молчит про файл,
    # который уже в индексе, — то есть ровно про случай `git add -f`.
    if git check-ignore -q --no-index -- "$f" 2>/dev/null; then
        deny "$f" "весь файл" ".gitignore закрывает этот путь; добавлен через git add -f"
        continue
    fi

    # Молча не пропускаем: не прочитали — значит, не проверили, и это отказ.
    if ! git show ":$f" > "$TMP" 2>/dev/null; then
        deny "$f" "весь файл" "не удалось прочитать содержимое из индекса — проверка не выполнена"
        continue
    fi

    # Двоичные и пустые файлы построчно не разбираем (-I: бинарь не совпадает).
    if ! grep -Iq . "$TMP" 2>/dev/null; then
        continue
    fi

    # --- ОТКАЗ 1: структура storage_state.json (живые cookie сессии).
    #     Ловим структуру, а не имя: файл переименовывается одной командой.
    #     Буква в скобках — не украшение: без неё образец совпадает сам
    #     с собой, и хук отвергал бы собственную правку. Раньше это скрывало
    #     исключение «пропустить сам хук»; исключения больше нет.
    if grep -q '"cook[i]es"' "$TMP" && grep -q '"orig[i]ns"' "$TMP"; then
        deny "$f" "$(grep -nE '"(cook[i]es|orig[i]ns)"' "$TMP" | hits)" \
             "структура storage_state (ключи cookies + origins)"
    fi

    # --- ОТКАЗ 2: заголовок Set-Cookie в записи трафика или дампе.
    if grep -qiE 'set-cookie[[:space:]]*:' "$TMP"; then
        deny "$f" "$(grep -niE 'set-cookie[[:space:]]*:' "$TMP" | hits)" \
             "заголовок Set-Cookie"
    fi

    # --- ОТКАЗ 3: длинная base64url-строка в файле, который не является кодом.
    #     Так выглядит содержимое daemon_token (secrets.token_urlsafe(24)).
    #     Отсев по составу: у настоящего токена есть и цифры, и оба регистра —
    #     это отбрасывает разделители вида ------ и слова_в_snake_case.
    if ! is_code "$f"; then
        grep -oE '[A-Za-z0-9_-]{24,}' "$TMP" 2>/dev/null \
            | grep '[a-z]' | grep '[A-Z]' | grep '[0-9]' > "$CAND" || true
        if [ -s "$CAND" ]; then
            deny "$f" "$(sed -n '1,3p' "$CAND")" \
                 "длинная base64url-строка вне кода (похоже на daemon_token)"
        fi
    fi

    # --- ОТКАЗ 4а: домашний каталог пользователя В ФОРМЕ ПУТИ.
    #     Образец общий: он не называет ничьей машины и потому остаётся
    #     литералом. Через класс символов ([Uu]sers), чтобы не совпадать
    #     самому с собой — хук проверяется наравне со всеми файлами.
    HOMEDIR='[\/][Uu]sers[\/][A-Za-z0-9._-]'
    if grep -qE "$HOMEDIR" "$TMP"; then
        deny "$f" "$(grep -nE "$HOMEDIR" "$TMP" | hits)" \
             "путь рабочей машины в форме пути (домашний каталог)"
    fi

    # --- ОТКАЗ 4б: имя пользователя ЭТОЙ машины (см. USERPAT выше).
    #     Пустой USERPAT означает, что имя получить не удалось; о пропуске
    #     уже сказано в stderr при запуске.
    if [ -n "$USERPAT" ] && grep -qiE "$USERPAT" "$TMP"; then
        deny "$f" "$(grep -niE "$USERPAT" "$TMP" | hits)" \
             "имя пользователя рабочей машины"
    fi

    # --- ОТКАЗ 5: путь внутрь venv. Образец общий, машину не называет.
    #
    # Правило заводилось под _common.ps1 и образец конфига, и обоих файлов
    # больше нет — но правило остаётся, и теперь без единого исключения.
    # После решения 14 путь внутрь venv стал не «одним из способов», а
    # признаком регрессии: исполняемые файлы берутся из PATH, регистрация
    # пишется как {"command": "garant-mcp"} и абсолютных путей не содержит
    # вовсе. Первым, кого потянет написать путь в каталог Scripts внутри
    # виртуального окружения, будет install.ps1 и справка к нему — ровно
    # тот случай, ради которого правило и держат. Номер шага установщика
    # здесь не назван нарочно: он уже менялся, а отсылка к устаревшему
    # номеру читается как признак, что устарело и само правило.
    # Образец этого пути здесь не пишется даже в комментарии: правило
    # сработало на нём при первой же пробе, и это ровно то поведение,
    # которого от него ждут.
    if grep -qE '\.venv[\/]Scripts' "$TMP"; then
        deny "$f" "$(grep -nE '\.venv[\/]Scripts' "$TMP" | hits)" \
             "путь внутрь venv — venv желателен, но не обязателен, и путь верен только из одного каталога"
    fi

    # --- ОТКАЗ 6: буква диска, а не схема URL: перед двоеточием ровно один
    # символ, и за разделителем не идёт второй слэш. Иначе https:// ловится
    # всегда.
    #
    # И не экранированный перевод строки: в питоновском исходнике конец
    # строки «…as e:\n"» для наивного образца выглядит как буква диска.
    # Отсекается по кавычке следом: у настоящего пути после n, r или t
    # идёт продолжение имени, у экранирования — конец литерала.
    # Второго детектора этого правила больше нет: он жил в acceptance.ps1,
    # удалённом решением 18. Раньше здесь стояло предупреждение «два
    # детектора обязаны понимать правило одинаково»; теперь он один, и это
    # не улучшение, а перенос ответственности — расходиться стало не с чем,
    # но и подстраховки на случай ошибки в образце не осталось.
    DRIVE='(^|[^A-Za-z0-9])[A-Za-z]:[\/]([^/nrt]|[nrt][^"'"'"']|$)'
    if grep -qE "$DRIVE" "$TMP"; then
        deny "$f" "$(grep -nE "$DRIVE" "$TMP" | hits)" \
             "буква диска в тексте — путь конкретной машины в примере или справке"
    fi

    # --- ОТКАЗ 7: образцы из .git/garant-secrets — следы прежней машины.
    #     Сами образцы в дереве не лежат (иначе детектор снова нёс бы то,
    #     что ищет); совпавшие строки показываем — они из проверяемого файла.
    if [ -s "$SEC" ]; then
        while IFS= read -r _pat; do
            [ -n "$_pat" ] || continue
            if grep -qE "$_pat" "$TMP" 2>/dev/null; then
                deny "$f" "$(grep -nE "$_pat" "$TMP" | hits)" \
                     "образец из .git/garant-secrets — след прежней машины или прежней раскладки"
            fi
        done < "$SEC"
    fi

done < "$LIST"

if [ "$FAIL" = "1" ]; then
    cat >&2 <<'MSG'
---------------------------------------------------------------------
Коммит отклонён. Причина в строках выше: либо секрет, который после
публикации не отзывается, либо путь, которого нет ни у кого, кроме
этой машины.
Уберите файл из индекса (git restore --staged <файл>) и исправьте.
Если вы понимаете, что делаете, обход: SKIP_GARANT_HOOK=1 git commit …
---------------------------------------------------------------------
MSG
    exit 1
fi

exit 0
